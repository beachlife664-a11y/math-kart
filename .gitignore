artifacts/art-v*/
artifacts/v*/
artifacts/reproduction/
artifacts/browser-compatibility-*.json
artifacts/release-smoke-*.json
assets/models/
assets/concepts/

# Delivery archives
*.zip
*.zip.tmp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
