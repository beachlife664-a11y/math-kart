# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
.env
.env.*
!.env.example

# Test output
test-results/
playwright-report/

# Local QA evidence and raw authoring inputs (not needed to run or build)
